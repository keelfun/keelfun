{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-api",
  "main": "src/index.ts",
  "account_id": "bc6c2a61a3e242fd07bef2a7dc1ec916",
  "routes": [{ "pattern": "api.keelfun.app", "custom_domain": true }],
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "INDEXER", "class_name": "Indexer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Indexer"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "RPC_URL": "https://base-rpc.publicnode.com",
    "CHAIN_ID": "8453",
    "FACTORY": "0x736dE2DbC4468F8224c63a11355980fB33949387",
    "HOOK": "0x7fA1311D29603211365b34a35eEF99208f06A8CC",
    "POOL_MANAGER": "0x498581ff718922c3f8e6a244956af099b2652b2b",
    "START_BLOCK": "59684172",
    "START_TICK": "200200"
  }
}
