{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-api",
  "main": "src/index.ts",
  "account_id": "bc6c2a61a3e242fd07bef2a7dc1ec916",
  "routes": [{ "pattern": "api.keelfun.app", "custom_domain": true }],
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "INDEXER", "class_name": "Indexer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Indexer"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "RPC_URL": "https://gateway.tenderly.co/public/base,https://base-pokt.nodies.app,https://1rpc.io/base,https://base.drpc.org,https://base-rpc.publicnode.com,https://mainnet.base.org",
    "LOG_SPAN": "50",
    "CHAIN_ID": "8453",
    "FACTORY": "0xDC802747d6c5271e2fC8a51bc52D279bDb80b463",
    "HOOK": "0xD7aDF63eDeb2e784bb949d9f848f9aE2D104A8Cc",
    "POOL_MANAGER": "0x498581ff718922c3f8e6a244956af099b2652b2b",
    "START_BLOCK": "59736515",
    "START_TICK": "200200"
  }
}
